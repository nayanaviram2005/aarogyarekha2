# Copy to .env and fill in. NEVER commit .env.

# --- Supabase (India region) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: API tier only, never shipped to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection strings (hosted Supabase). Fill whichever you have; the API tier
# uses DATABASE_URL_POOLER at runtime and DATABASE_URL_DIRECT for migrations.
# Direct (db.<ref>.supabase.co:5432): migrations, long-lived admin tasks. IPv6 only on free plans.
DATABASE_URL_DIRECT=
# Pooler (aws-0-ap-south-1.pooler.supabase.com): transaction mode :6543 for the API, session mode :5432 for migrations over IPv4.
DATABASE_URL_POOLER=
# Which one the API uses at runtime: pooler | direct
DATABASE_URL_RUNTIME=direct

# --- AI provider (provider-agnostic adapter) ---
# One of: mock | gemini | claude | openai | openrouter
AI_PROVIDER=mock

# Per-provider slots. Fill only the one(s) you use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Safety: external AI receives de-identified payloads only. Do not change without review.
AI_REQUIRE_DEIDENTIFICATION=true
AI_LOG_PAYLOADS=false

# Optional: give each AI task its own key (and optionally its own provider and model) so one task's rate limit cannot starve another.
# Anything left empty uses the main AI_PROVIDER, key and model above. TRANSLATE = translation, TRIAGE = priority second opinion,
# STT = speech to text, VISION = reading report photos (needs a vision-capable model; Gemini also reads PDFs).
AI_TRANSLATE_PROVIDER=
AI_TRANSLATE_API_KEY=
AI_TRANSLATE_MODEL=
AI_TRIAGE_PROVIDER=
AI_TRIAGE_API_KEY=
AI_TRIAGE_MODEL=
AI_STT_PROVIDER=
AI_STT_API_KEY=
AI_STT_MODEL=
AI_VISION_PROVIDER=
AI_VISION_API_KEY=
AI_VISION_MODEL=

# When the AI service is busy or out of quota (429 or 5xx) the request is tried once more after this pause, in milliseconds.
AI_RETRY_AFTER_MS=2500
# If it is STILL busy: one try on a fallback MODEL (same provider and key), then one on a fallback PROVIDER, which is called with its own
# standard key and model settings above (for example OPENROUTER_API_KEY and OPENROUTER_MODEL). A fallback provider receives the same redacted
# text, so name it in your consent notice. It applies to translation and the priority opinion. Reading report images (not redactable) and
# speech use a fallback provider only if AI_VISION_FALLBACK_PROVIDER names one. Leave all of these empty to have no fallback.
# Note: some model names stop being offered to new keys (gemini-2.5-flash did). List what your key can use before choosing one.
AI_FALLBACK_MODEL=
AI_FALLBACK_PROVIDER=
AI_TRANSLATE_FALLBACK_PROVIDER=
AI_TRIAGE_FALLBACK_PROVIDER=
AI_VISION_FALLBACK_PROVIDER=

# --- Speech / OCR ---
# Speech to text uses the AI_STT_* settings above, or AI_PROVIDER and its key when those are empty.
OCR_PROVIDER=local
# Photos: local = Tesseract on this server (heavy). ai = read by the outside AI image reader (Gemini vision; needs the patient AI consent and the AI_VISION_* or GEMINI key). ai_then_local = AI first, local if it cannot.
OCR_PHOTOS=local

# --- API tier ---
API_PORT=8787
# Hosting: a host like Render sets PORT itself. Set API_HOST=0.0.0.0 there so its router can reach the service (the default is loopback only).
API_HOST=
API_ALLOWED_ORIGINS=http://localhost:5173
SESSION_IDLE_LOCK_MINUTES=10
UPLOAD_MAX_MB=10
MFA_REQUIRED=true

# Retention worker only (never loaded by the API server). Days to keep uploaded files; unset = nothing is deleted by age.
RETENTION_DOCUMENT_DAYS=

# Requests per minute allowed from one address across the whole API (default 600). Costly or sensitive routes have their own lower limits.
RATE_LIMIT_PER_MINUTE=600

# Most different patients one person may open in an hour before access is paused and reported (0 turns it off).
ACCESS_BUDGET_PATIENTS_PER_HOUR=80

# Text messages to patients (their queue status after a nurse or doctor signs off).
# SMS_PROVIDER=mock (the default) sends nothing. Use twilio only when the account below is set up AND your sender and message
# templates are registered for India (DLT). Replies (STOP) are checked with the auth token, so SMS_WEBHOOK_URL must be the exact public
# address you gave Twilio, for example https://your-api.example.org/sms/inbound
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=   
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_WEBHOOK_URL=
